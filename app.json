{
  "expo": {
    "name": "Jellyfin",
    "slug": "jellyfin-ios",
    "main": "index.js",
    "owner": "jellyfin",
    "privacy": "unlisted",
    "platforms": [
      "ios"
    ],
    "version": "1.7.0",
    "orientation": "default",
    "primaryColor": "#00a4dc",
    "backgroundColor": "#101010",
    "icon": "./node_modules/@jellyfin/ux-ios/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./node_modules/@jellyfin/ux-ios/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#101010"
    },
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "deploymentTarget": "15.1",
      "buildNumber": "1.7.0.8",
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.nickbenthem.jellyfin-ios",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera.",
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ],
        "LSSupportsOpeningDocumentsInPlace": true,
        "UIFileSharingEnabled": true
      }
    },
    "plugins": [
      [
        "react-native-google-cast",
        {
          "iosReceiverAppId": "CC1AD845"
        }
      ]
    ],
    "description": "Jellyfin"
  }
}
